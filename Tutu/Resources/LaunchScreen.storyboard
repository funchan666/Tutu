<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23500"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="brand-mascot" translatesAutoresizingMaskIntoConstraints="NO" id="launch-icon">
                                <rect key="frame" x="140.5" y="370" width="112" height="112"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="112" id="icon-width"/>
                                    <constraint firstAttribute="height" constant="112" id="icon-height"/>
                                </constraints>
                            </imageView>
                            <stackView opaque="NO" contentMode="scaleToFill" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="launch-lights">
                                <rect key="frame" x="176.5" y="510" width="40" height="8"/>
                                <subviews>
                                    <imageView userInteractionEnabled="NO" alpha="0.35" contentMode="scaleAspectFit" image="tab-party-active" translatesAutoresizingMaskIntoConstraints="NO" id="light-one">
                                        <rect key="frame" x="0.0" y="0.0" width="8" height="8"/>
                                        <constraints><constraint firstAttribute="width" constant="8" id="one-width"/><constraint firstAttribute="height" constant="8" id="one-height"/></constraints>
                                    </imageView>
                                    <imageView userInteractionEnabled="NO" alpha="0.65" contentMode="scaleAspectFit" image="tab-party-active" translatesAutoresizingMaskIntoConstraints="NO" id="light-two">
                                        <rect key="frame" x="16" y="0.0" width="8" height="8"/>
                                        <constraints><constraint firstAttribute="width" constant="8" id="two-width"/><constraint firstAttribute="height" constant="8" id="two-height"/></constraints>
                                    </imageView>
                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="tab-party-active" translatesAutoresizingMaskIntoConstraints="NO" id="light-three">
                                        <rect key="frame" x="32" y="0.0" width="8" height="8"/>
                                        <constraints><constraint firstAttribute="width" constant="8" id="three-width"/><constraint firstAttribute="height" constant="8" id="three-height"/></constraints>
                                    </imageView>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-icon" firstAttribute="centerX" secondItem="launch-root" secondAttribute="centerX" id="icon-center-x"/>
                            <constraint firstItem="launch-icon" firstAttribute="centerY" secondItem="launch-root" secondAttribute="centerY" id="icon-center-y"/>
                            <constraint firstItem="launch-lights" firstAttribute="centerX" secondItem="launch-root" secondAttribute="centerX" id="lights-center-x"/>
                            <constraint firstItem="launch-lights" firstAttribute="top" secondItem="launch-icon" secondAttribute="bottom" constant="28" id="lights-top"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-first-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="brand-mascot" width="1024" height="1024"/>
        <image name="tab-party-active" width="26" height="26"/>
    </resources>
</document>
