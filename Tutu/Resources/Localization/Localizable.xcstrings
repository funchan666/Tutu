    "Daily Check adds 10 activity points. Levels recognise participation and do not unlock private communication.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily Check adds 10 activity points. Levels recognise participation and do not unlock private communication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro diario añade 10 puntos. Los niveles reflejan participación, no desbloquean comunicación privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une visite quotidienne rapporte 10 points. Les niveaux reflètent la participation et ne débloquent pas les échanges privés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日チェックインで10ポイントを獲得します。レベルは参加状況を示すもので、プライベートな連絡機能を解放するものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日打卡增加 10 活跃积分。等级仅体现参与度，不会解锁私聊权限。"
          }
        }
      }
    },
