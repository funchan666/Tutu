    "Logging out keeps your saved account. Deleting your account removes its credentials and associated saved content. It does not cancel an Apple transaction or delete your Apple ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging out keeps your saved account. Deleting your account removes its credentials and associated saved content. It does not cancel an Apple transaction or delete your Apple ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión conserva tu cuenta. Eliminarla borra las credenciales y el contenido asociado, pero no cancela transacciones de Apple ni elimina tu Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion conserve votre compte. Sa suppression efface les identifiants et contenus associés, sans annuler les transactions Apple ni supprimer votre identifiant Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトしてもアカウントは残ります。アカウント削除では認証情報と関連データを消去しますが、Apple の取引や Apple ID は削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录会保留账号。删除账号将移除凭据及关联内容，但不会取消 Apple 交易或删除 Apple ID。"
          }
        }
      }
    },
