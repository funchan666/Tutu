          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして録音"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击录制语音消息"
          }
        }
      }
    },
    "Tell me about a piece, a color or a plan. We'll start with a combination and refine the details.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me about a piece, a color or a plan. We'll start with a combination and refine the details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntame una prenda, un color o un plan. Empezaremos por una combinación y afinaremos los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez-moi d’un vêtement, d’une couleur ou d’un projet. Nous commencerons par une association, puis affinerons les détails."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテム、色、予定を教えてください。組み合わせを考えてから、細部を整えましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我一件衣服、一种颜色或出行计划，我们从基础搭配开始，再完善细节。"
          }
        }
      }
    },
