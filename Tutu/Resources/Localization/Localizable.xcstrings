    "Your profile, preferences, relationships, looks, comments, and wallet records are stored in this app's private storage. Password verification data is protected by Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, preferences, relationships, looks, comments, and wallet records are stored in this app's private storage. Password verification data is protected by Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil, preferencias, relaciones, looks, comentarios y cartera se guardan en el almacenamiento privado de la app. Keychain protege los datos de verificación de contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, préférences, relations, looks, commentaires et portefeuille sont enregistrés dans le stockage privé de l’app. Le trousseau protège les données de vérification du mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、設定、つながり、投稿、コメント、ウォレット記録はアプリ専用領域に保存されます。パスワード検証データはキーチェーンで保護されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料、偏好、关系、动态、评论和钱包记录保存在应用私有存储中，密码验证数据由钥匙串保护。"
          }
        }
      }
    },
