    "Clear your conversation on this device. Your remaining free replies and coin balance stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your conversation on this device. Your remaining free replies and coin balance stay the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la conversación de este dispositivo. Tus respuestas gratis y saldo no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez la conversation sur cet appareil. Vos réponses gratuites et votre solde restent inchangés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の会話を消去します。無料返信の残り回数とコイン残高は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空本设备的聊天记录。剩余免费次数和金币余额不会改变。"
          }
        }
      }
    },
