    "New accounts receive 360 coins once, after completing their profile and entering the home screen. Coins never expire.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New accounts receive 360 coins once, after completing their profile and entering the home screen. Coins never expire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas nuevas reciben 360 monedas una vez tras completar el perfil y entrar al inicio. No caducan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux comptes reçoivent une fois 360 pièces après avoir complété leur profil et ouvert l’accueil. Elles n’expirent pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規アカウントはプロフィールを完成しホームに入ると、一度だけ360コインを獲得します。有効期限はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新账号完善资料并进入首页后可一次性获得 360 金币，金币永不过期。"
          }
        }
      }
    },
