    "Member messages, voice and video chats, browsing, likes, comments and posting never cost coins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member messages, voice and video chats, browsing, likes, comments and posting never cost coins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes, llamadas, navegación, me gusta, comentarios y publicaciones no cuestan monedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, appels, navigation, mentions J’aime, commentaires et publications ne coûtent aucune pièce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、音声・ビデオチャット、閲覧、いいね、コメント、投稿にコインはかかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户消息、语音和视频聊天、浏览、点赞、评论及发布动态均不消耗金币。"
          }
        }
      }
    },
    "Member posts, messages and original media stay in their original language.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member posts, messages and original media stay in their original language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las publicaciones, los mensajes y los contenidos originales conservan su idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications, les messages et les médias d’origine conservent leur langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーの投稿、メッセージ、元のメディアは原文のまま表示されます。"
          }
        },
        "zh-Hans": {
