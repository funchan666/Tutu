    "No harassment, hate, threats, impersonation, scams, or sharing another person's private information. Respect boundaries and consent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No harassment, hate, threats, impersonation, scams, or sharing another person's private information. Respect boundaries and consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se prohíben el acoso, odio, amenazas, suplantación, estafas y difusión de información privada. Respeta los límites y el consentimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcèlement, haine, menaces, usurpation, arnaques et partage d’informations privées sont interdits. Respectez les limites et le consentement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嫌がらせ、差別、脅迫、なりすまし、詐欺、他人の個人情報の共有は禁止です。相手の意思と境界を尊重してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止骚扰、仇恨、威胁、冒充、诈骗及泄露他人隐私。尊重边界与同意。"
          }
        }
      }
    },
