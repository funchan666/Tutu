    "Follow each other before sending a message or starting a call. Your message will stay here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow each other before sending a message or starting a call. Your message will stay here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguid a la otra persona antes de enviar mensajes o llamar. Tu mensaje se conservará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez-vous mutuellement avant d’envoyer un message ou d’appeler. Votre message est conservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージや通話には相互フォローが必要です。入力した内容は保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互相关注后才能发消息或通话，你的消息会保留在这里。"
          }
        }
      }
    },
    "Follow each other before starting a call.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow each other before starting a call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguid a la otra persona antes de llamar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez-vous mutuellement avant d’appeler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話するには相互フォローが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互相关注后才能通话。"
          }
        }
      }
    },
    "Follow from profiles and search. To send a private message or call, both people must follow each other and the connection must be verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow from profiles and search. To send a private message or call, both people must follow each other and the connection must be verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a personas desde sus perfiles o la búsqueda. Los mensajes privados y llamadas requieren seguimiento mutuo y conexión verificada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez des personnes depuis leur profil ou la recherche. Messages privés et appels nécessitent un suivi mutuel et un lien vérifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールや検索からフォローできます。個別のメッセージや通話には相互フォローと接続の確認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在主页或搜索页关注用户。私聊或通话需要双方互相关注，且连接已经验证。"
          }
        }
      }
    },
