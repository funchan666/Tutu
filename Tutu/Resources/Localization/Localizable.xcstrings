    "Unlock the Runway Ribbon avatar frame for 240 coins, or collect gifts for 40–1,800 coins each. Wear an owned gift as your profile charm at no additional cost.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the Runway Ribbon avatar frame for 240 coins, or collect gifts for 40–1,800 coins each. Wear an owned gift as your profile charm at no additional cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el marco por 240 monedas o colecciona regalos de 40 a 1800 monedas. Usa tus regalos como adornos sin coste adicional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez le cadre pour 240 pièces ou collectionnez des cadeaux de 40 à 1 800 pièces. Portez vos cadeaux sans frais supplémentaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームは240コイン、ギフトは各40〜1,800コインで入手できます。持っているギフトは追加料金なしでチャームにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "240 金币可解锁秀场丝带头像框，礼物每件 40–1,800 金币。已拥有的礼物可免费佩戴为主页挂饰。"
          }
        }
      }
    },
