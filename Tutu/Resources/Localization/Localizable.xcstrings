    "Retry a failed action after checking your connection. Unsent messages remain in the conversation. Gift delivery failures leave your inventory intact.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry a failed action after checking your connection. Unsent messages remain in the conversation. Gift delivery failures leave your inventory intact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión y reintenta. Los mensajes no enviados se conservan y los regalos fallidos no reducen tu inventario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion puis réessayez. Les messages non envoyés sont conservés et les échecs d’envoi de cadeaux ne réduisent pas votre inventaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して再度お試しください。未送信メッセージは会話に残り、ギフトの送信に失敗してもアイテムは減りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络后重试。未发送的消息会保留在会话中，礼物发送失败不会扣除库存。"
          }
        }
      }
    },
    "Returning to welcome…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
