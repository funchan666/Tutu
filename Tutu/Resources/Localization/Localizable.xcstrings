    "Tutu is for people aged 18 and older. Share style, music, and conversation with kindness.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutu is for people aged 18 and older. Share style, music, and conversation with kindness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutu es para mayores de 18 años. Comparte estilo, música y conversación con amabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutu s’adresse aux personnes de 18 ans et plus. Partagez style, musique et conversations avec bienveillance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutu は18歳以上の方が対象です。思いやりを持ってスタイル、音楽、会話を楽しみましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutu 面向 18 岁及以上用户。请友善分享穿搭、音乐和交流。"
          }
        }
      }
    },
    "Tutu · 1.0.0": {},
    "US reference prices. Tap a pack to get its current Apple price; confirm payment in Apple's purchase sheet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US reference prices. Tap a pack to get its current Apple price; confirm payment in Apple's purchase sheet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precios de referencia de EE. UU. Toca un paquete para ver el precio actual y confirma en la hoja de compra de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix indicatifs américains. Touchez un pack pour consulter le prix actuel, puis confirmez dans la fenêtre d’achat Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国の参考価格です。パックを選ぶと Apple の現在の価格を取得し、Apple の購入画面で支払いを確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示美元参考价。点击套餐获取 Apple 当前价格，并在 Apple 购买界面确认支付。"
          }
        }
      }
    },
