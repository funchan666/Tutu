          }
        }
      }
    },
    "Rewards are 10, 20, 10, 20, 10, 20, then 100 coins. A missed day starts a new streak. After day seven, a new seven-day cycle begins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewards are 10, 20, 10, 20, 10, 20, then 100 coins. A missed day starts a new streak. After day seven, a new seven-day cycle begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recompensas son 10, 20, 10, 20, 10, 20 y 100 monedas. Si faltas un día, la racha reinicia. Tras el séptimo día comienza otro ciclo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récompenses sont de 10, 20, 10, 20, 10, 20 puis 100 pièces. Un jour manqué relance la série. Un nouveau cycle commence après le septième jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報酬は順に10、20、10、20、10、20、100コインです。1日休むと連続記録がリセットされ、7日目の後は新しい周期が始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "七天奖励依次为 10、20、10、20、10、20、100 金币。中断后重新累计，第七天后开启新一轮。"
          }
        }
      }
    },
