    "Apple couldn't complete this purchase. If payment already went through, use Check pending purchases to recover it. You won't be credited twice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple couldn't complete this purchase. If payment already went through, use Check pending purchases to recover it. You won't be credited twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no pudo completar la compra. Si ya pagaste, usa Revisar compras pendientes para recuperarla. No se acreditará dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas pu terminer l’achat. Si le paiement a été effectué, vérifiez les achats en attente pour le récupérer. Il ne sera pas crédité deux fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple が購入を完了できませんでした。支払い済みの場合は保留中の購入を確認して復元してください。二重に付与されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未能完成购买。如果已经支付，请通过检查待处理购买恢复，金币不会重复到账。"
          }
        }
      }
    },
