    "Gift delivery to another member is currently unavailable. Use your collected gifts as profile charms or reusable room effects on this device. Heart Beat room effects are free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gift delivery to another member is currently unavailable. Use your collected gifts as profile charms or reusable room effects on this device. Heart Beat room effects are free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío a otros usuarios no está disponible. Usa los regalos como adornos o efectos reutilizables en este dispositivo. Heart Beat es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi à d’autres membres est indisponible. Utilisez vos cadeaux comme breloques ou effets réutilisables sur cet appareil. Heart Beat est gratuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のユーザーへのギフト送信は現在利用できません。集めたギフトは、この端末でチャームや繰り返し使えるルーム演出になります。Heart Beat は無料です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持向其他用户赠送礼物。已拥有的礼物可用作主页挂饰或本设备的可重复房间特效。心动特效免费。"
          }
        }
      }
    },
