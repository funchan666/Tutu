    "AI when available, with prepared style guides as a fallback. Photos are kept for inspiration; advice uses your words.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI when available, with prepared style guides as a fallback. Photos are kept for inspiration; advice uses your words."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos IA cuando está disponible y guías preparadas en caso contrario. Las fotos son inspiración; los consejos se basan en tu descripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA est utilisée si disponible, sinon des guides préparés prennent le relais. Les photos servent d’inspiration ; les conseils reposent sur vos mots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な場合は AI、それ以外は用意されたスタイルガイドを使用します。写真は参考用で、アドバイスは文章に基づきます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用可用的 AI，否则提供预制搭配指南。照片用作灵感参考，建议基于你的文字描述。"
          }
        }
      }
    },
