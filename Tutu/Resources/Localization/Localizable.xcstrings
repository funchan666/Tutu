    "Their profile, rooms, posts and chats are now hidden. You can manage blocked members in Privacy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their profile, rooms, posts and chats are now hidden. You can manage blocked members in Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su perfil, salas, publicaciones y chats están ocultos. Puedes gestionar los bloqueos en Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son profil, ses salons, ses publications et ses discussions sont masqués. Gérez les blocages dans Confidentialité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、ルーム、投稿、チャットを非表示にしました。プライバシー設定で管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该用户的主页、房间、动态及聊天已隐藏。可在隐私设置管理拉黑用户。"
          }
        }
      }
    },
    "There are no more looks to show right now.": {
