    "Do not pressure anyone to buy or send gifts. Gifts do not grant a right to attention, a reply, or a private call.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not pressure anyone to buy or send gifts. Gifts do not grant a right to attention, a reply, or a private call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No presiones a nadie para comprar o enviar regalos. Un regalo no da derecho a atención, respuestas ni llamadas privadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’incitez personne sous pression à acheter ou envoyer des cadeaux. Ils ne donnent aucun droit à l’attention, à une réponse ou à un appel privé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入やギフトの送信を強要しないでください。ギフトによって相手の注目、返信、個人的な通話を要求する権利は得られません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要强迫他人购买或赠送礼物。礼物不代表有权要求关注、回复或私聊通话。"
          }
        }
      }
    },
    "Don't have an account? Create Account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
