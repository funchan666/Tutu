    "Media selected from Photos is copied into the app. Deleting an in-app photo or account never deletes your original Photos library items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media selected from Photos is copied into the app. Deleting an in-app photo or account never deletes your original Photos library items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de Fotos se copian a la app. Borrar fotos o la cuenta en la app no elimina los originales de Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médias de Photos sont copiés dans l’app. Supprimer une photo ou un compte dans l’app ne supprime jamais les originaux dans Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリから選んだメディアはコピーされます。アプリ内の写真やアカウントを削除しても、写真ライブラリの原本は消えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册素材会复制到应用中。删除应用内照片或账号不会删除系统相册原件。"
          }
        }
      }
    },
