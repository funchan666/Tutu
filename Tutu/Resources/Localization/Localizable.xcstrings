    },
    "Tap a pack to get that product from Apple. The Apple purchase sheet shows the final local price. Only verified transactions add coins. Your wallet is saved on this device, and consumable coins are not restored like subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a pack to get that product from Apple. The Apple purchase sheet shows the final local price. Only verified transactions add coins. Your wallet is saved on this device, and consumable coins are not restored like subscriptions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un paquete para obtenerlo de Apple. Su hoja de compra muestra el precio local final. Solo las transacciones verificadas añaden monedas. La cartera se guarda en este dispositivo; las monedas consumibles no se restauran como suscripciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un pack pour obtenir le produit Apple. La fenêtre d’achat affiche le prix local final. Seules les transactions vérifiées ajoutent des pièces. Le portefeuille est local ; les pièces consommables ne sont pas restaurées comme les abonnements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パックを選ぶと Apple の商品を取得し、購入画面に最終価格が表示されます。確認済みの取引だけでコインが追加されます。ウォレットはこの端末に保存され、消耗型コインはサブスクリプションのようには復元されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击套餐获取 Apple 商品，购买界面会显示最终本地价格。验证交易后才会增加金币。钱包保存在本设备，消耗型金币无法像订阅一样恢复。"
          }
        }
      }
    },
    "Tap to record your message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to record your message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para grabar tu mensaje"
          }
        },
        "fr": {
