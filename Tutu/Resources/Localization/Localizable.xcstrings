    "Only share media you have permission to use. Sexual exploitation, nudity, graphic violence, dangerous activity, and illegal material are not permitted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only share media you have permission to use. Sexual exploitation, nudity, graphic violence, dangerous activity, and illegal material are not permitted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte solo contenido que tengas permiso de usar. Se prohíben la explotación sexual, desnudos, violencia gráfica, actividades peligrosas y material ilegal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez uniquement des médias autorisés. Exploitation sexuelle, nudité, violence graphique, activités dangereuses et contenus illégaux sont interdits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する権利のあるメディアだけを共有してください。性的搾取、ヌード、過激な暴力、危険行為、違法な内容は禁止です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅分享有权使用的素材。禁止性剥削、裸露、血腥暴力、危险活动和违法内容。"
          }
        }
      }
    },
