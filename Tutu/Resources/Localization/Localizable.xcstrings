    "Coins never expire. Your wallet and items are saved to this account on this device. Cross-device wallet sync is not available. The final price and currency are shown by Apple before you pay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coins never expire. Your wallet and items are saved to this account on this device. Cross-device wallet sync is not available. The final price and currency are shown by Apple before you pay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las monedas no caducan. La cartera y los objetos se guardan en esta cuenta y dispositivo, sin sincronización entre dispositivos. Apple muestra el precio final y la moneda antes de pagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces n’expirent pas. Le portefeuille et les objets sont enregistrés sur ce compte et cet appareil, sans synchronisation entre appareils. Apple affiche le prix final et la devise avant le paiement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コインに有効期限はありません。ウォレットとアイテムはこの端末のアカウントに保存され、端末間の同期はできません。支払い前に Apple が最終価格と通貨を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金币永不过期。钱包和物品保存在本设备的当前账号中，暂不支持跨设备同步。支付前 Apple 会显示最终价格和币种。"
          }
        }
      }
    },
    "Collect for your backpack or wear as a profile charm. Remote delivery is currently unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect for your backpack or wear as a profile charm. Remote delivery is currently unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guárdalos en tu mochila o úsalos como adorno. El envío remoto no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collectionnez-les ou portez-les sur votre profil. L’envoi à distance est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッグに集めたり、プロフィールのチャームとして使えます。相手への送信は現在利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏到背包，或作为主页挂饰佩戴。暂不支持远程赠送。"
          }
        }
      }
    },
