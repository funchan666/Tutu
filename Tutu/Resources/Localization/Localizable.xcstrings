    "Hosts should remove disruptive participants. Never record or share another person's voice or image without permission.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosts should remove disruptive participants. Never record or share another person's voice or image without permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los anfitriones deben retirar a quienes perturben la sala. No grabes ni compartas la voz o imagen de otra persona sin permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hôtes doivent exclure les personnes perturbatrices. N’enregistrez ni ne partagez la voix ou l’image d’autrui sans autorisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストは迷惑行為をする参加者を退出させてください。許可なく他人の音声や画像を記録・共有してはいけません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "房主应移除扰乱秩序的参与者，未经允许不得录制或分享他人的声音与影像。"
          }
        }
      }
    },
