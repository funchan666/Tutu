    "On-device AI when available, otherwise curated style guides. Confirm each paid reply; canceled or unsaved replies use no coins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI when available, otherwise curated style guides. Confirm each paid reply; canceled or unsaved replies use no coins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA local cuando está disponible; si no, guías de estilo. Confirma cada respuesta de pago. Las canceladas o no guardadas no cuestan monedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IA locale si disponible, sinon guides de style. Confirmez chaque réponse payante ; une réponse annulée ou non enregistrée ne coûte rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末上の AI が利用できない場合はスタイルガイドを使います。有料返信ごとに確認が必要です。キャンセルや保存失敗ではコインを使いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用设备端 AI，否则提供精选搭配指南。付费回复均需确认，取消或未保存的回复不扣金币。"
          }
        }
      }
    },
