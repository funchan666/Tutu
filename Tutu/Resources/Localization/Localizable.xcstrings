    "Chrome curves. Orchid silk.\nA signature frame for your entrance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome curves. Orchid silk.\nA signature frame for your entrance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curvas cromadas, seda orquídea.\nUn marco para destacar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbes chromées, soie orchidée.\nUn cadre pour vous distinguer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロームの曲線、蘭色のシルク。\nあなたらしい登場を彩るフレーム。"
          }
        },
