        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes, llamadas de voz y vídeo, navegación, me gusta, comentarios y publicaciones siempre son gratis."
          }
        },
        "fr": {
          "stringUnit": {
